# Astro public configuration. These values identify the Sanity project and are
# safe to use while building the public site.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Optional production URL used for canonical links and social preview images.
# Vercel deployments can use VERCEL_PROJECT_PRODUCTION_URL automatically.
PUBLIC_SITE_URL=

# Server/build-only token. Leave empty when published content is public.
# Never prefix this with PUBLIC_ and never commit the real value.
SANITY_API_READ_TOKEN=
# Required only for `npm run sanity:seed`; keep this server-side and never use PUBLIC_.
SANITY_API_WRITE_TOKEN=
