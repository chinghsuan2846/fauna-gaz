---
import { toHTML } from '@portabletext/to-html'
import { sanityClient } from 'sanity:client'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { articleBySlugQuery, articleSlugsQuery } from '../../lib/queries.js'
import { sanityImageUrl } from '../../lib/sanityImage.js'
import '../../styles/global.css'

export async function getStaticPaths() {
  if (!import.meta.env.PUBLIC_SANITY_PROJECT_ID) return []

  const articles = await sanityClient.fetch(articleSlugsQuery)

  return articles.map(({ slug }) => ({
    params: { slug },
    props: { slug },
  }))
}

const { slug } = Astro.props
const article = await sanityClient.fetch(articleBySlugQuery, { slug })

if (!article) {
  throw new Error(`Article not found for slug: ${slug}`)
}

const description = article.excerpt || 'Fauna Gaz quarterly journal article.'
const bodyHtml = toHTML(article.body || [])
const coverImageUrl = sanityImageUrl(article.coverImage, { width: 1600 })
---

<BaseLayout
  title={`${article.title} — Fauna Gaz`}
  description={description}
  image={coverImageUrl}
>
  <main class="min-h-screen bg-window-surface px-space-md py-space-2xl font-body text-body text-ink-primary sm:px-space-xl lg:px-space-2xl">
    <a class="font-ui text-action-link underline decoration-action-link underline-offset-2" href="/">← Fauna Gaz</a>
    <article class="mx-auto mt-space-2xl w-full max-w-3xl">
      <p class="font-ui text-body text-ink-secondary">
        {article.issue?.year} · {article.issue?.quarter}
      </p>
      <h1 class="mt-space-md max-w-[15ch] text-headline font-medium">{article.title}</h1>
      {article.excerpt && <p class="mt-space-md max-w-2xl text-lead text-ink-primary">{article.excerpt}</p>}
      {coverImageUrl && (
        <img
          class="my-space-xl block h-auto w-full"
          src={coverImageUrl}
          alt={article.coverImage.alt || article.title}
          loading="eager"
        />
      )}
      <p class="font-ui text-caption text-ink-muted">
        {article.publishedAt && new Date(article.publishedAt).toLocaleDateString('zh-TW')}
      </p>
      <div class="portable-text mt-space-xl" set:html={bodyHtml} />
    </article>
  </main>
</BaseLayout>
