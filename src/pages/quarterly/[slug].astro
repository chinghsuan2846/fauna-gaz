---
import { sanityClient } from 'sanity:client'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { articleBySlugQuery, articleSlugsQuery } from '../../lib/queries.js'
import { sanityImageUrl } from '../../lib/sanityImage.js'
import QuarterlyContent, { type QuarterlyContentArticle } from '../../stories/component/QuarterlyContent'
import '../../styles/global.css'

type BodySpan = {
  text?: string
  marks?: string[]
}

type BodyBlock = {
  _type?: string
  children?: BodySpan[]
}

export async function getStaticPaths() {
  if (!import.meta.env.PUBLIC_SANITY_PROJECT_ID) return []

  const articles = await sanityClient.fetch(articleSlugsQuery)

  return articles.map(({ slug }) => ({
    params: { slug },
    props: { slug },
  }))
}

const { slug } = Astro.props
const article = await sanityClient.fetch(articleBySlugQuery, { slug })

if (!article) {
  throw new Error(`Article not found for slug: ${slug}`)
}

const description = article.excerpt || 'Fauna Gaz quarterly journal article.'
const coverImageUrl = sanityImageUrl(article.coverImage, { width: 1600 })
const bodyBlocks = (article.body || []) as BodyBlock[]
const contentArticle: QuarterlyContentArticle = {
  id: article._id,
  year: String(article.issue?.year ?? ''),
  quarter: article.issue?.quarter || '',
  title: article.title,
  paragraphs: bodyBlocks
    .filter((block) => block._type === 'block')
    .map((block, index) => ({
      id: `${article._id}-paragraph-${index}`,
      segments: (block.children || [])
        .filter((span) => span.text)
        .map((span) => ({
          ...(span.marks?.includes('strong') ? { kind: 'strong' as const } : {}),
          text: span.text || '',
        })),
    }))
    .filter((paragraph) => paragraph.segments.length > 0),
  previous: null,
  next: null,
}
---

<BaseLayout
  title={`${article.title} — Fauna Gaz`}
  description={description}
  image={coverImageUrl}
>
  <main class="flex h-screen min-h-0 flex-col gap-space-md overflow-hidden bg-window-surface p-space-md font-body text-body text-ink-primary sm:p-space-xl lg:p-space-2xl">
    <a class="shrink-0 font-ui text-action-link underline decoration-action-link underline-offset-2" href="/">← Fauna Gaz</a>
    <div class="mx-auto flex min-h-0 w-full max-w-viewport-tablet flex-1">
      <QuarterlyContent client:load article={contentArticle} />
    </div>
  </main>
</BaseLayout>
