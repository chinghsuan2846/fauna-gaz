---
import { sanityClient } from 'sanity:client'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { isQuarterlyArticleHidden, toQuarterlyContentArticle } from '../../lib/contentAdapter'
import { articleListQuery, articleSlugsQuery } from '../../lib/queries.js'
import { sanityImageUrl } from '../../lib/sanityImage.js'
import QuarterlyContent from '../../stories/component/QuarterlyContent'
import '../../styles/global.css'

export async function getStaticPaths() {
  if (!import.meta.env.PUBLIC_SANITY_PROJECT_ID) return []

  const articles = await sanityClient.fetch(articleSlugsQuery)

  return articles.filter((article) => !isQuarterlyArticleHidden(article)).map(({ slug }) => ({
    params: { slug },
    props: { slug },
  }))
}

const { slug } = Astro.props
const allArticles = await sanityClient.fetch(articleListQuery)
const visibleArticles = allArticles.filter((candidate) => !isQuarterlyArticleHidden(candidate))
const article = visibleArticles.find((candidate) => candidate.slug === slug)

if (!article) {
  throw new Error(`Article not found for slug: ${slug}`)
}

const description = article.excerpt || 'Fauna Gaz quarterly journal article.'
const coverImageUrl = sanityImageUrl(article.coverImage, { width: 1600 })
const articleIndex = visibleArticles.findIndex((candidate) => candidate._id === article._id)
const contentArticle = toQuarterlyContentArticle(article, visibleArticles[articleIndex - 1], visibleArticles[articleIndex + 1])
---

<BaseLayout
  title={`${article.title} — Fauna Gaz`}
  description={description}
  image={coverImageUrl}
>
  <main class="flex h-screen min-h-0 flex-col gap-space-md overflow-hidden bg-window-surface p-space-md font-body text-body text-ink-primary sm:p-space-xl lg:p-space-2xl">
    <a class="shrink-0 font-ui text-action-link underline decoration-action-link underline-offset-2" href="/">← Fauna Gaz</a>
    <div class="mx-auto flex min-h-0 w-full max-w-viewport-tablet flex-1">
      <QuarterlyContent client:load article={contentArticle} />
    </div>
  </main>
</BaseLayout>
