---
import { termsOfUse } from '../lib/legalContent'
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/global.css'
---

<BaseLayout title="使用條款｜動物公報">
  <main class="min-h-screen bg-window-surface p-space-lg text-ink-primary">
    <article class="legal-document mx-auto grid max-w-viewport-tablet gap-space-lg">
      <header class="legal-document-header">
        <h1 class="font-body text-title font-medium">{termsOfUse.title}</h1>
        {termsOfUse.updatedAt && <p class="legal-document-updated">{termsOfUse.updatedAt}</p>}
        {termsOfUse.intro && <p class="legal-document-intro">{termsOfUse.intro}</p>}
      </header>

      <div class="legal-document-sections">
        {termsOfUse.sections.map((section) => (
          <section class="legal-document-section">
            {section.heading && <h2>{section.heading}</h2>}
            <div class="legal-document-blocks">
              {section.blocks.map((block) =>
                block.type === 'list' ? (
                  <ul class="legal-document-list">
                    {block.items.map((item) => <li>{item}</li>)}
                  </ul>
                ) : (
                  <p>{block.text}</p>
                ),
              )}
            </div>
          </section>
        ))}
      </div>

      <a class="w-fit font-ui text-action-link underline" href="/">回到動物公報</a>
    </article>
  </main>
</BaseLayout>
