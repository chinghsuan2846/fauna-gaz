---
import { sanityClient } from 'sanity:client'
import DesktopExperience from '../components/DesktopExperience'
import BaseLayout from '../layouts/BaseLayout.astro'
import { isQuarterlyArticleHidden, toContactInfo } from '../lib/contentAdapter'
import { demoArticles, demoCharacters, demoSiteSettings } from '../lib/demoContent'
import { articleListQuery, characterListQuery, quarterlyPdfListQuery, siteSettingsQuery } from '../lib/queries.js'
import '../styles/global.css'

const hasSanityConfig = Boolean(import.meta.env.PUBLIC_SANITY_PROJECT_ID)
const [articles, quarterlyPdfs, siteSettings, characters] = hasSanityConfig
  ? await Promise.all([
      sanityClient.fetch(articleListQuery),
      sanityClient.fetch(quarterlyPdfListQuery),
      sanityClient.fetch(siteSettingsQuery),
      sanityClient.fetch(characterListQuery),
    ])
  : [demoArticles, [], demoSiteSettings, demoCharacters]
const visibleArticles = articles.filter((article) => !isQuarterlyArticleHidden(article))
const contact = toContactInfo(siteSettings)
---

<BaseLayout
  title="Fauna Gaz"
  description="Fauna Gaz — a quarterly journal for animal behaviour."
  image="/assets/og-image.png"
  bodyClass="experience-page"
  preloadForest
>
  <DesktopExperience client:load articles={visibleArticles} quarterlyPdfs={quarterlyPdfs} characters={characters} contact={contact} />
</BaseLayout>
