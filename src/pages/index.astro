---
import { sanityClient } from 'sanity:client'
import DesktopExperience from '../components/DesktopExperience'
import BaseLayout from '../layouts/BaseLayout.astro'
import type { SanityArticle, SanityCharacter, SanityQuarterlyPdf, SanitySiteSettings } from '../lib/contentAdapter'
import { isQuarterlyArticleHidden, toContactInfo } from '../lib/contentAdapter'
import { demoArticles, demoCharacters, demoSiteSettings } from '../lib/demoContent'
import { articleListQuery, characterListQuery, quarterlyPdfListQuery, siteSettingsQuery } from '../lib/queries.js'
import '../styles/global.css'

const hasSanityConfig = Boolean(import.meta.env.PUBLIC_SANITY_PROJECT_ID)
let articles: SanityArticle[] = demoArticles
let quarterlyPdfs: SanityQuarterlyPdf[] = []
let siteSettings: SanitySiteSettings | null = demoSiteSettings
let characters: SanityCharacter[] = demoCharacters
let contentState: 'empty' | 'error' | undefined

if (hasSanityConfig) {
  try {
    ;[articles, quarterlyPdfs, siteSettings, characters] = await Promise.all([
      sanityClient.fetch(articleListQuery),
      sanityClient.fetch(quarterlyPdfListQuery),
      sanityClient.fetch(siteSettingsQuery),
      sanityClient.fetch(characterListQuery),
    ])
  } catch {
    articles = []
    quarterlyPdfs = []
    siteSettings = null
    characters = []
    contentState = 'error'
  }

  if (!contentState && articles.length === 0 && quarterlyPdfs.length === 0) contentState = 'empty'
}

const visibleArticles = articles.filter((article) => !isQuarterlyArticleHidden(article))
const contact = toContactInfo(siteSettings)
---

<BaseLayout
  title="動物公報｜動物行為學季刊"
  description="動物公報是一本以動物行為學為主題的獨立季刊，將研究論文轉化為好讀的故事，帶你認識動物的生活、智慧與奇妙行為。"
  image="/assets/og-image.png"
  bodyClass="experience-page"
  preloadForest
>
  <DesktopExperience
    client:load
    articles={visibleArticles}
    quarterlyPdfs={quarterlyPdfs}
    characters={characters}
    contact={contact}
    contentState={contentState}
  />
</BaseLayout>
